# Copy to .env at the repo root to override docker-compose defaults.
# Do not commit the real .env file.

AUTH_SECRET=change-me-generate-a-long-random-string
DEFAULT_ADMIN_EMAIL=admin@mastercraftautony.com
DEFAULT_ADMIN_PASSWORD=Mastercraft2026!
DEFAULT_ADMIN_NAME=Mastercraft Admin
ENABLE_DEFAULT_ADMIN=true

# Optional Neon Auth JWT verification
NEON_AUTH_URL=
NEON_AUTH_JWKS_URL=

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Frontend build-time values
VITE_API_URL=http://localhost:4000/api
VITE_NEON_AUTH_URL=
