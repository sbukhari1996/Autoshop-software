{
  "name": "collision-shop-local",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/frontend",
    "dev": "npm-run-all -p dev:api dev:web",
    "build": "npm run build --workspace apps/api && npm run build --workspace apps/frontend",
    "db:generate": "npm run db:generate --workspace apps/api",
    "db:migrate": "npm run db:migrate --workspace apps/api"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "allowScripts": {
    "@prisma/client@5.10.2": true,
    "@prisma/engines@5.10.2": true,
    "prisma@5.10.2": true,
    "core-js@3.50.0": true,
    "esbuild@0.28.2": true
  }
}
