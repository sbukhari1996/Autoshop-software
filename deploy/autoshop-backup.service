[Unit]
Description=Back up Autoshop PostgreSQL database and uploads
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
Environment=RCLONE_CONFIG=/root/.config/rclone/rclone.conf
Environment=RCLONE_REMOTE=gdrive-crypt:
ExecStart=/opt/autoshop/backup/backup-linux.sh
TimeoutStartSec=1h
