# Copy to .env on the production server. Never commit the real file.

POSTGRES_DB=collision_shop
POSTGRES_USER=collision_shop_app
POSTGRES_PASSWORD=generate-a-long-random-password

# Generate with: openssl rand -hex 32
AUTH_SECRET=generate-a-long-random-secret

DEFAULT_ADMIN_EMAIL=admin@mastercraftauto.com
DEFAULT_ADMIN_PASSWORD=set-a-strong-password-then-rotate-it
DEFAULT_ADMIN_NAME=Mastercraft Admin
# Keep false once the real admin account exists.
ENABLE_DEFAULT_ADMIN=false

# Optional Neon Auth / Google OAuth
NEON_AUTH_URL=
NEON_AUTH_JWKS_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.mastercraftauto.com/api/auth/google/callback

# Baked into the frontend build — must be the public API URL.
VITE_API_URL=https://api.mastercraftauto.com/api
VITE_NEON_AUTH_URL=
