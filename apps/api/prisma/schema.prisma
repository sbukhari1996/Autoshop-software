generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String                   @id @default(cuid())
  email       String                   @unique
  name        String
  password    String
  role        String                   @default("staff")
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  memberships OrganizationMembership[]

  @@map("users")
}

model Organization {
  id          String                   @id @default(cuid())
  name        String
  slug        String                   @unique
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  memberships OrganizationMembership[]
  todos       CompanyTodo[]

  @@map("organizations")
}

model CompanyTodo {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  dueDate        DateTime
  completed      Boolean      @default(false)
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, completed, dueDate])
  @@map("company_todos")
}

model OrganizationMembership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("viewer")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
  @@map("organization_memberships")
}

model Customer {
  id          String             @id @default(cuid())
  firstName   String
  lastName    String
  phone       String?
  email       String?
  address     String?
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  vehicles    Vehicle[]
  claims      Claim[]
  jobs        Job[]
  inspections Inspection[]
  invoices    Invoice[]
  documents   CustomerDocument[]

  @@map("customers")
}

model Vehicle {
  id           String   @id @default(cuid())
  customerId   String
  year         Int?
  make         String?
  model        String?
  trim         String?
  bodyClass    String?
  vin          String?
  licensePlate String?
  licenseState String?
  color        String?
  notes        String?
  registrationDetails String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  jobs     Job[]
  claims   Claim[]

  @@map("vehicles")
}

model Claim {
  id                      String    @id @default(cuid())
  customerId              String
  vehicleId               String?
  claimNumber             String?
  customerName            String?
  customerPhone           String?
  customerInsurance       String?
  customerPolicyNumber    String?
  customerClaimNumber     String?
  customerAddress         String?
  lossType                String?
  driverLicense           String?
  vehicleYear             Int?
  vehicleMake             String?
  vehicleModel            String?
  vehicleVin              String?
  vehicleTrim             String?
  vehicleBodyClass        String?
  vehicleColor            String?
  vehicleLicensePlate     String?
  vehiclePlateState       String?
  atFaultDriverName       String?
  atFaultDriverPhone      String?
  atFaultDriverLicense    String?
  atFaultDriverDlState    String?
  atFaultPlate            String?
  atFaultPlateState       String?
  atFaultVehicleVin       String?
  atFaultVehicleYear      Int?
  atFaultVehicleMake      String?
  atFaultVehicleModel     String?
  atFaultVehicleTrim      String?
  atFaultVehicleBodyClass String?
  atFaultVehicleColor     String?
  atFaultInsurance        String?
  atFaultPolicyNumber     String?
  atFaultClaimNumber      String?
  atFaultInsurancePhone   String?
  incidentDate            DateTime?
  policeReportNumber      String?
  policeDepartment        String?
  witnessName             String?
  witnessPhone            String?
  damagePhotos            Boolean   @default(false)
  platePhotos             Boolean   @default(false)
  atFaultDlPhotos         Boolean   @default(false)
  insuranceCardPhotos     Boolean   @default(false)
  policeReportFiled       Boolean   @default(false)
  witnessStatement        Boolean   @default(false)
  estimateAttached        Boolean   @default(false)
  readyToSubmit           Boolean   @default(false)
  photoFolderLink         String?
  insuranceCompany        String?
  adjusterName            String?
  adjusterPhone           String?
  adjusterEmail           String?
  adjusterVisitAt         DateTime?
  claimStatus             String    @default("new")
  dateSubmitted           DateTime?
  policeReportFile        String?
  notes                   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  customer       Customer        @relation(fields: [customerId], references: [id])
  vehicle        Vehicle?        @relation(fields: [vehicleId], references: [id])
  jobs           Job[]
  documents      ClaimDocument[]
  inspections    Inspection[]
  invoices       Invoice[]
  financeEntries FinanceEntry[]

  @@map("claims")
}

model Estimate {
  id                     String   @id @default(cuid())
  jobId                  String?
  estimateNumber         String?  @unique
  status                 String   @default("draft")
  totalAmount            Float    @default(0)
  taxRate                Float    @default(8.875)
  bodyRate               Float    @default(63)
  paintRate              Float    @default(63)
  supplyRate             Float    @default(41)
  mechanicRate            Float    @default(80)
  damageSummary          String?
  carrier                String?
  appraisalCompanyName   String?
  workfileId             String?  @unique
  ownerName              String?
  insuredName            String?
  policyNumber           String?
  claimNumber            String?
  lossType               String?
  dateOfLoss             String?
  pointOfImpact          String?
  daysToRepair           String?
  writtenBy              String?
  nyAdjusterLicense      String?
  writtenByPhone         String?
  insuranceAdjuster      String?
  insuranceAdjusterPhone String?
  inspectionLocation     String?
  repairFacility         String?
  odometer               String?
  exteriorColor          String?
  interiorColor          String?
  engine                 String?
  productionDate         String?
  vehicleCondition       String?
  vehicleFeatures        String[] @default([])
  walkInCustomerName     String?
  walkInCustomerAddress  String?
  walkInCustomerPhone    String?
  walkInVehicleYear      Int?
  walkInVehicleMake      String?
  walkInVehicleModel     String?
  walkInVehicleTrim      String?
  walkInVehicleBodyClass String?
  walkInVehicleVin       String?
  walkInVehicleLicense   String?
  walkInVehicleState     String?
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  job       Job?               @relation(fields: [jobId], references: [id])
  lineItems EstimateLineItem[]

  @@map("estimates")
}

model EstimateLineItem {
  id            String   @id @default(cuid())
  estimateId    String
  parentLineId  String?
  sortOrder     Int      @default(0)
  section       String?
  operation     String?
  description   String
  partNumber    String?
  quantity      Float    @default(1)
  unitPrice     Float    @default(0)
  laborHours    Float    @default(0)
  mechanicHours Float    @default(0)
  paintHours    Float    @default(0)
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  estimate   Estimate           @relation(fields: [estimateId], references: [id])
  parentLine EstimateLineItem?  @relation("EstimateLineHierarchy", fields: [parentLineId], references: [id], onDelete: Cascade)
  subLines   EstimateLineItem[] @relation("EstimateLineHierarchy")

  @@index([estimateId, sortOrder])
  @@map("estimate_line_items")
}

model Job {
  id             String    @id @default(cuid())
  customerId     String
  vehicleId      String?
  claimId        String?
  jobNumber      String    @unique
  status         String    @default("new")
  arrivalDate    DateTime?
  inspectionDate DateTime?
  dueDate        DateTime?
  totalRevenue   Float     @default(0)
  totalExpenses  Float     @default(0)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer       Customer              @relation(fields: [customerId], references: [id])
  vehicle        Vehicle?              @relation(fields: [vehicleId], references: [id])
  claim          Claim?                @relation(fields: [claimId], references: [id])
  estimates      Estimate[]
  expenses       JobExpense[]
  financeEntries FinanceEntry[]
  inspections    Inspection[]
  documents      JobDocument[]
  statusHistory  JobStatusHistory[]
  authorizations RepairAuthorization[]
  invoices       Invoice[]

  @@map("jobs")
}

model HistoricalImportRecord {
  sourceKey  String   @id
  entityType String
  recordId   String
  importedAt DateTime @default(now())

  @@unique([entityType, recordId])
  @@index([entityType])
  @@map("historical_import_records")
}

model Inspection {
  id             String    @id @default(cuid())
  jobId          String?
  customerId     String?
  claimId        String?
  scheduledFor   DateTime?
  inspectorName  String?
  inspectorPhone String?
  insuranceRep   String?
  status         String    @default("scheduled")
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  job      Job?      @relation(fields: [jobId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  claim    Claim?    @relation(fields: [claimId], references: [id])

  @@index([jobId])
  @@index([customerId])
  @@index([claimId])
  @@map("inspections")
}

model JobExpense {
  id          String    @id @default(cuid())
  jobId       String
  description String
  amount      Float
  category    String?
  receiptFile String?
  expenseDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  job         Job       @relation(fields: [jobId], references: [id])

  @@map("job_expenses")
}

model JobStatusHistory {
  id         String   @id @default(cuid())
  jobId      String
  fromStatus String
  toStatus   String
  note       String?
  createdAt  DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@map("job_status_history")
}

model FinanceEntry {
  id              String   @id @default(cuid())
  type            String
  description     String
  category        String?
  amount          Float
  paymentMethod   String?
  entryDate       DateTime @default(now())
  jobId           String?
  claimId         String?
  documentId      String?
  sourceReference String?  @unique
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  job       Job?                   @relation(fields: [jobId], references: [id], onDelete: SetNull)
  claim     Claim?                 @relation(fields: [claimId], references: [id], onDelete: SetNull)
  documents FinanceEntryDocument[]

  @@index([entryDate])
  @@index([type])
  @@index([jobId])
  @@index([claimId])
  @@map("finance_entries")
}

model FinanceEntryDocument {
  id        String   @id @default(cuid())
  entryId   String
  fileName  String
  filePath  String
  createdAt DateTime @default(now())

  entry FinanceEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@map("finance_entry_documents")
}

model Employee {
  id         String           @id @default(cuid())
  name       String
  phone      String?
  email      String?
  role       String?
  weeklyRate Float            @default(0)
  startDate  DateTime         @default(now())
  active     Boolean          @default(true)
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  payments   PayrollPayment[]

  @@map("employees")
}

model PayrollPayment {
  id              String   @id @default(cuid())
  employeeId      String
  amount          Float
  paymentDate     DateTime @default(now())
  paymentMethod   String?
  notes           String?
  sourceReference String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("payroll_payments")
}

model RentalTenant {
  id            String          @id @default(cuid())
  name          String
  phone         String?
  email         String?
  space         String          @default("mechanical")
  shift         String          @default("day")
  rentAmount    Float           @default(0)
  rentFrequency String          @default("daily")
  startDate     DateTime        @default(now())
  active        Boolean         @default(true)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  payments      RentalPayment[]

  @@index([active, startDate])
  @@map("rental_tenants")
}

model RentalPayment {
  id              String   @id @default(cuid())
  tenantId        String
  type            String   @default("rent")
  amount          Float
  paymentDate     DateTime @default(now())
  paymentMethod   String?
  notes           String?
  sourceReference String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant RentalTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, paymentDate])
  @@map("rental_payments")
}

model BankAccount {
  id              String   @id @default("default")
  name            String   @default("Primary bank")
  startingBalance Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("bank_accounts")
}

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  customerId    String?
  jobId         String?
  claimId       String?
  walkInCustomerName    String?
  walkInCustomerAddress String?
  walkInCustomerPhone   String?
  walkInCustomerEmail   String?
  walkInVehicleYear     Int?
  walkInVehicleMake     String?
  walkInVehicleModel    String?
  walkInVehicleTrim     String?
  walkInVehicleVin      String?
  walkInVehicleLicense  String?
  walkInVehicleState    String?
  status        String    @default("draft")
  issueDate     DateTime  @default(now())
  dueDate       DateTime?
  subtotal      Float     @default(0)
  tax           Float     @default(0)
  total         Float     @default(0)
  amountPaid    Float     @default(0)
  balanceDue    Float     @default(0)
  notes         String?
  pdfFileName   String?
  pdfFilePath   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customer  Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  job       Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  claim     Claim?            @relation(fields: [claimId], references: [id], onDelete: SetNull)
  lineItems InvoiceLineItem[]
  payments  Payment[]
  documents InvoiceDocument[]

  @@index([customerId])
  @@index([jobId])
  @@index([claimId])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  method    String
  amount    Float
  date      DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payments")
}

model RecurringExpense {
  id        String    @id @default(cuid())
  name      String
  category  String?
  amount    Float
  frequency String    @default("monthly")
  startDate DateTime
  endDate   DateTime?
  active    Boolean   @default(true)
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  payments  RecurringExpensePayment[]

  @@index([active, startDate])
  @@map("recurring_expenses")
}

model RecurringExpensePayment {
  id                 String   @id @default(cuid())
  recurringExpenseId String
  period             String
  amount             Float
  paidAt             DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  recurringExpense RecurringExpense @relation(fields: [recurringExpenseId], references: [id], onDelete: Cascade)

  @@unique([recurringExpenseId, period])
  @@index([period])
  @@map("recurring_expense_payments")
}

model RepairAuthorization {
  id          String   @id @default(cuid())
  jobId       String
  fileName    String
  filePath    String
  status      String   @default("generated")
  generatedAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@map("repair_authorizations")
}

model ClaimDocument {
  id           String   @id @default(cuid())
  claimId      String
  fileName     String
  filePath     String
  documentType String?
  description  String?
  createdAt    DateTime @default(now())

  claim Claim @relation(fields: [claimId], references: [id])

  @@map("claim_documents")
}

model CustomerDocument {
  id           String   @id @default(cuid())
  customerId   String
  fileName     String
  filePath     String
  documentType String?
  description  String?
  createdAt    DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_documents")
}

model JobDocument {
  id           String   @id @default(cuid())
  jobId        String
  fileName     String
  filePath     String
  documentType String?
  description  String?
  createdAt    DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id])

  @@map("job_documents")
}

model InvoiceDocument {
  id           String   @id @default(cuid())
  invoiceId    String
  fileName     String
  filePath     String
  documentType String   @default("receipt")
  description  String?
  createdAt    DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_documents")
}
