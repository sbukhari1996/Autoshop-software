generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("staff")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Customer {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  phone       String?
  email       String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vehicles    Vehicle[]
  claims      Claim[]
  jobs        Job[]

  @@map("customers")
}

model Vehicle {
  id           String   @id @default(cuid())
  customerId   String
  year         Int?
  make         String?
  model        String?
  vin          String?
  licensePlate String?
  color        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer     Customer @relation(fields: [customerId], references: [id])
  jobs         Job[]
  claims       Claim[]

  @@map("vehicles")
}

model Claim {
  id               String   @id @default(cuid())
  customerId       String
  vehicleId        String?
  claimNumber      String?
  insuranceCompany String?
  adjusterName     String?
  adjusterPhone    String?
  claimStatus      String   @default("new")
  policeReportFile String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customer         Customer @relation(fields: [customerId], references: [id])
  vehicle          Vehicle? @relation(fields: [vehicleId], references: [id])
  jobs             Job[]
  documents        ClaimDocument[]

  @@map("claims")
}

model Estimate {
  id            String   @id @default(cuid())
  jobId         String
  estimateNumber String?
  status        String   @default("draft")
  totalAmount   Float    @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  job           Job      @relation(fields: [jobId], references: [id])
  lineItems     EstimateLineItem[]

  @@map("estimates")
}

model EstimateLineItem {
  id          String   @id @default(cuid())
  estimateId  String
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  laborHours  Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  estimate    Estimate @relation(fields: [estimateId], references: [id])

  @@map("estimate_line_items")
}

model Job {
  id                String   @id @default(cuid())
  customerId        String
  vehicleId         String?
  claimId           String?
  jobNumber         String   @unique
  status            String   @default("new")
  arrivalDate       DateTime?
  inspectionDate    DateTime?
  dueDate           DateTime?
  totalRevenue      Float    @default(0)
  totalExpenses     Float    @default(0)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer          Customer @relation(fields: [customerId], references: [id])
  vehicle           Vehicle? @relation(fields: [vehicleId], references: [id])
  claim             Claim?   @relation(fields: [claimId], references: [id])
  estimate          Estimate[]
  expenses          JobExpense[]
  inspections      Inspection[]
  documents        JobDocument[]

  @@map("jobs")
}

model Inspection {
  id            String   @id @default(cuid())
  jobId         String
  scheduledFor  DateTime?
  inspectorName String?
  insuranceRep  String?
  status        String   @default("scheduled")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  job           Job      @relation(fields: [jobId], references: [id])

  @@map("inspections")
}

model JobExpense {
  id          String   @id @default(cuid())
  jobId       String
  description String
  amount      Float
  category    String?
  receiptFile String?
  expenseDate DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  job         Job      @relation(fields: [jobId], references: [id])

  @@map("job_expenses")
}

model ClaimDocument {
  id          String   @id @default(cuid())
  claimId     String
  fileName    String
  filePath    String
  documentType String?
  createdAt   DateTime @default(now())

  claim       Claim     @relation(fields: [claimId], references: [id])

  @@map("claim_documents")
}

model JobDocument {
  id          String   @id @default(cuid())
  jobId       String
  fileName    String
  filePath    String
  documentType String?
  createdAt   DateTime @default(now())

  job         Job      @relation(fields: [jobId], references: [id])

  @@map("job_documents")
}
