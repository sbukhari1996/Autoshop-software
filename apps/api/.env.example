DATABASE_URL="postgresql://collision_shop_app:collision_shop_app@localhost:5433/collision_shop?schema=public"
PORT=4000
AUTH_SECRET="replace-with-a-long-random-secret"
# Optional Neon Auth JWT verification. JWKS URL takes precedence when set.
NEON_AUTH_URL="https://your-neon-auth-host/neondb/auth"
NEON_AUTH_JWKS_URL="https://your-neon-auth-host/neondb/auth/.well-known/jwks.json"
# Optional Google OAuth configuration. Endpoints report configuration-required until all are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"
DEFAULT_ADMIN_EMAIL="admin@mastercraftautony.com"
DEFAULT_ADMIN_PASSWORD="Mastercraft2026!"
DEFAULT_ADMIN_NAME="Mastercraft Admin"
# Keep false in production unless you intentionally need a bootstrap account.
ENABLE_DEFAULT_ADMIN="false"
